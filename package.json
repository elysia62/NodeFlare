{
  "name": "nodeflare",
  "version": "1.0.0",
  "private": true,
  "repository": "https://github.com/elysia62/NodeFlare",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "sh dev.sh",
    "dev:frontend": "bun run --cwd frontend dev",
    "start": "sh start.sh",
    "build": "bun run build:frontend && bun run build:backend",
    "build:agent": "sh scripts/build-agent.sh",
    "build:backend": "sh scripts/build-backend.sh",
    "build:frontend": "sh scripts/build-frontend.sh",
    "test:smoke": "sh scripts/smoke-test.sh",
    "check": "sh scripts/check.sh",
    "test:e2e": "playwright test",
    "test:e2e:types": "sh -c 'cd frontend && ./node_modules/.bin/tsc -p ../tsconfig.e2e.json'",
    "test:visual": "playwright test visual",
    "test:visual:update": "playwright test visual --update-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "playwright": "^1.64.1",
    "ws": "^8.22.0"
  }
}
